# Modelo do .env (este arquivo vai para o Git; o .env, NUNCA).
#
# Como recriar o .env (máquina nova, ou depois de restaurar uma cópia de segurança, que não leva o .env):
#   1. copie este arquivo para .env, na mesma pasta;
#   2. preencha as linhas marcadas com [SEGREDO] com o que está guardado no gerenciador de senhas
#      (nota "Integra Folha - .env"); as outras já vêm com o valor padrão;
#   3. confira sem gastar nada: .\.venv\Scripts\python.exe -m pytest tests/test_provedores_de_ia.py
#      (e, com MODE=llm, a primeira leitura mostra se a chave foi aceita).
# Os segredos ficam só no .env e no gerenciador de senhas: nunca no Git, nunca na
# cópia de segurança. Chave de API perdida se gera de novo no painel do provedor.

# Modo de execução: "mock" (sem chave, sem custo, respostas simuladas) ou "llm" (provedor real)
MODE=mock

# Proteção de custo: acima deste número de chamadas ao LLM numa operação (um envio, uma conversa), a IA pausa (ADR-145)
LIMITE_CHAMADAS_LLM_POR_SESSAO=50
# Teto de gasto por operação, em dólares (ao atingir, a IA pausa).
# A trava final é o limite de crédito configurado em cada conta dos provedores
TETO_DE_GASTO_USD=10.00
# MOCK de reserva (ADR-145), SÓ na máquina local: "sim" faz a IA real que não responde (provedor fora, ou os dois
# limites acima) cair para a resposta simulada, como era antes. Serve para a demo sem rede e para as medições (que
# recusam a resposta simulada e contam a falha). "nao" (padrão): a IA que não responde PAUSA o trabalho (o envio
# espera em "Tentar de novo"), e nada é simulado. No servidor, a chave nunca chega (o compose não a repassa)
MOCK_DE_RESERVA=nao

# Qual banco a aplicação usa (ADR-67; docs/banco_de_dados.md):
#   sqlite   = um arquivo, sem servidor (padrão; é o que os testes usam e o que roda sem instalar nada)
#   postgres = servidor PostgreSQL (o ambiente local de uso e a produção)
BANCO=sqlite
# Banco SQLite da aplicação (usado quando BANCO=sqlite)
CAMINHO_BANCO=storage/integra_folha.db

# PostgreSQL (usado quando BANCO=postgres). Nunca escreva senhas aqui no .env.example.
# POSTGRES_ADMIN_URL: o superusuário, usado SÓ por scripts/preparar_postgres.py para criar o usuário e os bancos.
# POSTGRES_URL e POSTGRES_URL_TESTES: preenchidas pelo próprio scripts/preparar_postgres.py (usuário sem
# superpoderes). Formato: postgresql://usuario:senha@localhost:5432/nome_do_banco
# [SEGREDO] as três têm senha dentro do endereço
POSTGRES_ADMIN_URL=
POSTGRES_URL=
POSTGRES_URL_TESTES=
# Só para o docker-compose.yml (aplicação + PostgreSQL em contêineres): senhas do administrador e do usuário da
# aplicação no banco do contêiner. Só letras e números (a segunda vai dentro do endereço de conexão)
# [SEGREDO] escolhidas por você na primeira subida do Docker
SENHA_POSTGRES_ADMIN=
SENHA_POSTGRES_APLICACAO=

# Senhas dos usuários da demo: SÓ para o servidor, onde ninguém digita.
# Na sua máquina, deixe em branco: scripts/criar_usuarios.py pergunta as senhas na tela.
# [SEGREDO] escolhidas por você (só no servidor)
SENHA_USUARIO_EMPRESA=
SENHA_USUARIO_BANCO=

# [SEGREDO] A senha única dos logins da base viva, usada por scripts/carregar_base_viva.py
SENHA_DA_BASE_VIVA=
# [SEGREDO] A senha dos usuários de teste, lida pelos testes e pelos roteiros de clique (tests/e2e/apoio.py)
SENHA_DOS_TESTES=

# Chaves dos provedores de IA (ADR-11). Só aqui, nunca no código nem no Git. Vazias, o modo "llm" avisa que falta a
# chave. Onde conseguir: no painel de cada provedor, na área de chaves de API (OpenAI: platform.openai.com;
# Anthropic: platform.claude.com). Quem tem a chave gasta o seu crédito: se vazar, apague a chave no painel e gere
# outra.
# [SEGREDO]
OPENAI_API_KEY=
# [SEGREDO]
ANTHROPIC_API_KEY=
# Por onde a chamada à IA passa (ADR-96): "bedrock" = a nossa conta na AWS, perfil EUA (o fornecedor do modelo
# não vê o pedido) ou "direta" = as APIs da OpenAI e da Anthropic acima. Com "bedrock",
# só a chave abaixo é usada (as duas de cima podem ficar vazias)
ROTA_DA_IA=bedrock
# A chave do Bedrock: console da AWS → Amazon Bedrock → Chaves de API → chave de longo prazo (validade de 90
# dias). Quem tem a chave gasta na sua conta da AWS: se vazar, apague a chave no console e gere outra
# [SEGREDO]
AWS_BEARER_TOKEN_BEDROCK=
# A região de onde as chamadas saem (o perfil EUA do Bedrock funciona a partir do Norte da Virgínia)
REGIAO_BEDROCK=us-east-1
# Os modelos que os agentes usam quando pedem "grande" ou "pequeno". Escolhidos pela comparação (EXP-008, ADR-11):
# Sonnet 5 no grande e GPT-6 Luna no pequeno. Enquanto a conta AWS não libera os dois, vale o plano B (ADR-107,
# EXP-014): Sonnet 4.6 no grande e Amazon Nova 2 Lite no pequeno, pelo Bedrock
MODELO_GRANDE=claude-sonnet-4-6
MODELO_PEQUENO=nova-2-lite
# Conferidor da Leitura (ADR-105): uma segunda IA confere a leitura do texto corrido (sim desde o EXP-015; nao desliga)
CONFERIDOR_DA_LEITURA=sim
# Leitor de Documentos (ADR-73): o esforço da IA ao ler um texto corrido (low, medium, high)
LEITOR_ESFORCO=low
# Interpretador (ADR-107): formato garantido pelo provedor (nao = como no EXP-008, padrão; sim = liga no Bedrock)
INTERPRETADOR_FORMATO_GARANTIDO=sim
# Agente de Endomarketing: sim = o prompt padrão (hoje a v5, ADR-150), com o tom de voz, os termos proibidos, a
# assinatura do kit e os benefícios escolhidos; nao = volta para o v3, que fica como histórico
ENDOMARKETING_COM_AS_KBS=sim

# Upload: tamanho máximo do arquivo (MB) e pasta dos originais (fora do Git)
LIMITE_UPLOAD_MB=5
PASTA_UPLOADS=storage/uploads
PASTA_HOMOLOGADOS=storage/homologados
# Pontos de salvamento do fluxo (onde cada processamento parou), quando BANCO=sqlite.
# Com BANCO=postgres, eles ficam nas tabelas checkpoint* do próprio PostgreSQL
CAMINHO_CHECKPOINTS=storage/checkpoints.db
