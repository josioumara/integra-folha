# =====================================================================================================================
# .env.exemplo: o modelo do .env de PRODUÇÃO (o arquivo de configuração do servidor), SEM nenhum valor secreto
#
# Como usar (no servidor, nunca na máquina local):
#   cp publicacao/.env.exemplo publicacao/.env && chmod 600 publicacao/.env
#   As senhas são NOVAS, geradas no próprio servidor (ex.: openssl rand -hex 24). O .env local nunca vai para lá.
#   A chave do Bedrock é colada à mão no servidor (pelo "nano"), e o valor nunca passa por mensagens nem pelo Git.
#   Conferir sem mostrar os segredos: docker compose ... config --quiet (SEMPRE com --quiet).
# =====================================================================================================================

# O nome do projeto no Docker (dá o nome dos volumes: integra-folha_dados_do_banco, ...).
COMPOSE_PROJECT_NAME=integra-folha
# A etiqueta da imagem no ar: o código do commit publicado (o publicar.sh preenche).
IMAGEM_TAG=
# O e-mail que o Let's Encrypt usa para avisar de problema no certificado.
EMAIL_DO_CERTIFICADO=

# ---- Banco (senhas novas, só letras e números, geradas no servidor) ----
SENHA_POSTGRES_ADMIN=
SENHA_POSTGRES_APLICACAO=

# ---- Usuários da demo (as senhas vêm do definir_senhas_da_demo.sh) ----
SENHA_USUARIO_EMPRESA=
SENHA_USUARIO_BANCO=

# ---- IA (MODE=mock até a IA real ser ligada, com o teto mensal definido) ----
MODE=mock
ROTA_DA_IA=bedrock
# A região de onde a aplicação chama a IA: TEM de ser us-east-1, onde a retenção zero está gravada.
REGIAO_BEDROCK=us-east-1
# A chave do Bedrock só de produção (colada à mão no servidor).
AWS_BEARER_TOKEN_BEDROCK=
# Os modelos em uso (ADR-107).
MODELO_GRANDE=claude-sonnet-4-6
MODELO_PEQUENO=nova-2-lite
INTERPRETADOR_FORMATO_GARANTIDO=sim
CONFERIDOR_DA_LEITURA=sim
LEITOR_ESFORCO=low
# O teto de gasto por sessão, em dólares, e o limite de chamadas à IA por sessão.
TETO_DE_GASTO_USD=
LIMITE_CHAMADAS_LLM_POR_SESSAO=50
